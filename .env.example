NEXT_PUBLIC_SITE_URL=https://www.rekur-app.com
NEXT_PUBLIC_URL=https://www.rekur-app.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_json

ADMIN_EMAIL=admin@rekur-app.com
ADMIN_PASSWORD=your_secure_admin_password_here

ADMIN_JWT_SECRET=your_32_character_random_admin_jwt_secret

# ------------------------------------------------------------------------------
# 5. CRON & INTERNAL RELAY SECURITY
# ------------------------------------------------------------------------------
# Secret token protecting /api/cron/* and /api/send-* messaging routes
# Generate with: openssl rand -hex 24
CRON_SECRET=your_secure_cron_secret_token
# (Optional) Passed by admin dashboard client if manually triggering cron from UI
NEXT_PUBLIC_CRON_SECRET=your_secure_cron_secret_token

# ------------------------------------------------------------------------------
# 6. LEMON SQUEEZY (Payments & Subscriptions)
# Obtain from: Lemon Squeezy Dashboard -> Settings
# ------------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_STORE_ID=your_lemon_squeezy_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# Product Variant IDs (Lemon Squeezy -> Products -> Variants)
NEXT_PUBLIC_LEMON_PRO_MONTHLY_VARIANT_ID=your_pro_monthly_variant_id
NEXT_PUBLIC_LEMON_PRO_YEARLY_VARIANT_ID=your_pro_yearly_variant_id
NEXT_PUBLIC_LEMON_BUSINESS_MONTHLY_VARIANT_ID=your_business_monthly_variant_id
NEXT_PUBLIC_LEMON_BUSINESS_YEARLY_VARIANT_ID=your_business_yearly_variant_id

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY (SendGrid / Nodemailer)
# ------------------------------------------------------------------------------
# SendGrid API Key (used for subscription reminder emails)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=notifications@rekur-app.com

# SMTP fallback / Nodemailer (used for transactional receipts)
EMAIL_USER=your_smtp_user_or_email
EMAIL_PASS=your_smtp_password
EMAIL_FROM=Rekur <notifications@rekur-app.com>

# ------------------------------------------------------------------------------
# 8. SMS DELIVERY (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 9. WHATSAPP NOTIFICATIONS (Meta Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_VERSION=v20.0
WHATSAPP_PHONE_ID=your_meta_whatsapp_phone_id
WHATSAPP_TOKEN=your_meta_whatsapp_system_user_token

# ------------------------------------------------------------------------------
# 10. STRIPE (Legacy / Optional)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
